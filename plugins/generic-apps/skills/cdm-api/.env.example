# Copiar a ~/.config/cdm-api/.env (chmod 600 en Mac/Linux) y completar. NO lo dejes dentro de
# la carpeta de la skill ni en el .env de un repo: el CLI ignora esos y así no viajan con la skill.
# Otra ubicación: definí CDM_ENV_FILE con la ruta completa.
# Completalo vos en este archivo: nunca pegues un token en el chat.

# Completá UNA de las dos opciones (cualquiera sirve).

# Opción A: token de Producteca. Ve la company de ese token.
CDM_BEARER=

# Opción B: master token del CDM + company por defecto. Con --company <id> consulta cualquier company.
CDM_MASTER_TOKEN=
CDM_COMPANY_ID=

# Opcional, solo para --all-companies (con master token): email @parsimotion.com dado de alta como admin en el CDM.
CDM_ADMIN_EMAIL=

# Opcional
# CDM_DOMAIN=https://apps.producteca.com/monitoring-center
# CDM_DEBUG=1
